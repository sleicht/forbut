#!/usr/bin/env bash
# bin/git-forbut — standalone CLI entry point for forbut
# Can be used directly:  forbut switch
# Or via git:            git forbut switch  (if on PATH)
#
# This file contains the command dispatch and all core logic.
# Shell functions in forbut.sh delegate here.

# NOTE: intentionally NOT using `set -euo pipefail`.
# forgit avoids strict mode because `git`/`but` routinely exit non-zero in
# valid flows (empty diffs, non-GitButler repos, missing optional fields).
# Commands handle errors explicitly via return codes instead.

# ---------------------------------------------------------------------------
# Resolve installation directory (relative to this script)
# ---------------------------------------------------------------------------
# Follow symlinks to find the real location of this script, then go up one
# level to get the install dir. This is needed because install.sh symlinks
# ~/.local/bin/git-forbut -> ~/.local/share/forbut/bin/git-forbut.
_forbut_resolve_script() {
    local src
    if [[ -n ${BASH_SOURCE[0]:-} ]]; then
        src="${BASH_SOURCE[0]}"
    elif [[ -n ${ZSH_VERSION:-} ]]; then
        # shellcheck disable=SC2296
        src="${(%):-%x}"
    else
        src="$0"
    fi
    # Resolve symlinks one hop at a time so we land on the real file.
    while [[ -L $src ]]; do
        local dir
        dir="$(cd -- "$(dirname -- "$src")" &>/dev/null && pwd)"
        src="$(readlink -- "$src")"
        [[ $src != /* ]] && src="$dir/$src"
    done
    echo "$src"
}

_FORBUT_SELF="$(_forbut_resolve_script)"
_FORBUT_BIN_DIR="$(cd -- "$(dirname -- "$_FORBUT_SELF")" &>/dev/null && pwd)"
_FORBUT_ROOT_DIR="$(cd -- "$_FORBUT_BIN_DIR/.." &>/dev/null && pwd)"

# FORBUT is the absolute path to this script. It is referenced inside fzf
# keybindings to re-enter the dispatcher for preview / enter / yank actions.
# Exported so the fzf subshells (--preview / --bind execute) inherit it.
export FORBUT="$_FORBUT_SELF"

# ---------------------------------------------------------------------------
# Load shared helpers and every command implementation
# ---------------------------------------------------------------------------
# shellcheck source=../lib/utils.sh disable=SC1091
. "$_FORBUT_ROOT_DIR/lib/utils.sh"

for _forbut_cmd_file in "$_FORBUT_ROOT_DIR"/cmds/*.sh; do
    # shellcheck source=/dev/null
    [[ -f $_forbut_cmd_file ]] && . "$_forbut_cmd_file"
done
unset _forbut_cmd_file

# ---------------------------------------------------------------------------
# Usage / help
# ---------------------------------------------------------------------------
_forbut_usage() {
    cat <<EOF
${FORBUT_COLOR_BOLD}forbut${FORBUT_COLOR_RESET} v${FORBUT_VERSION} — fuzzy UX for GitButler's but CLI

${FORBUT_COLOR_BOLD}USAGE${FORBUT_COLOR_RESET}
    forbut <command> [options]

${FORBUT_COLOR_BOLD}MVP COMMANDS (v0.1)${FORBUT_COLOR_RESET}
    switch      Fuzzy-switch between virtual branches/stacks
    log         Browse commit log across current stack with diff preview
    diff        Browse changed files with inline diff preview
    assign      Fuzzy-select uncommitted hunks and assign to a stack
    discard     Fuzzy-select hunks/files to discard

${FORBUT_COLOR_BOLD}PLANNED COMMANDS (v0.2+)${FORBUT_COLOR_RESET}
    reorder     Interactively reorder commits within a stack

${FORBUT_COLOR_BOLD}INTERNAL COMMANDS${FORBUT_COLOR_RESET}
    preview     Preview dispatcher (used by fzf callbacks)

${FORBUT_COLOR_BOLD}OPTIONS${FORBUT_COLOR_RESET}
    -h, --help      Show this help
    -v, --version   Show version

${FORBUT_COLOR_BOLD}ENVIRONMENT${FORBUT_COLOR_RESET}
    FORBUT_PAGER              Override the diff pager (default: delta or git core.pager)
    FORBUT_PREVIEW_PAGER      Override the fzf preview pager
    FORBUT_FZF_DEFAULT_OPTS   Extra fzf options applied to all commands
    FORBUT_NO_ALIASES         Set to 1 to disable alias registration
    FORBUT_*_FZF_OPTS         Per-command fzf overrides (e.g., FORBUT_LOG_FZF_OPTS)

${FORBUT_COLOR_BOLD}ALIASES${FORBUT_COLOR_RESET} (when sourcing forbut.sh)
    fbs   forbut::switch
    fbl   forbut::log
    fbd   forbut::diff
    fba   forbut::assign
    fbD   forbut::discard
    fbr   forbut::reorder

See https://github.com/user/forbut for full documentation.
EOF
}

# ---------------------------------------------------------------------------
# Command registries (≈ forgit's PUBLIC_COMMANDS / PRIVATE_COMMANDS)
# Alphabetised so this block diffs cleanly against bin/git-forgit.
# ---------------------------------------------------------------------------
PUBLIC_COMMANDS=(
    "assign"
    "diff"
    "discard"
    "log"
    "reorder"
    "switch"
)

# Private commands (used by fzf callbacks, not user-facing)
PRIVATE_COMMANDS=(
    "enter"
    "preview"
    "yank_sha"
)

# ---------------------------------------------------------------------------
# Command dispatch
# ---------------------------------------------------------------------------
main() {
    local cmd="${1:-}"

    case "$cmd" in
        -h | --help | help | "")
            _forbut_usage
            return 0
            ;;
        -v | --version | version)
            echo "forbut $FORBUT_VERSION"
            return 0
            ;;
        preview)
            shift
            _forbut_preview "$@"
            return $?
            ;;
        enter)
            shift
            _forbut_enter "$@"
            return $?
            ;;
        yank_sha)
            shift
            _forbut_yank_sha "$@"
            return $?
            ;;
    esac

    # Set shell for fzf preview commands
    SHELL="$(which bash)"
    export SHELL

    # shellcheck disable=SC2076
    if [[ ! " ${PUBLIC_COMMANDS[*]} " =~ " ${cmd} " ]] && [[ ! " ${PRIVATE_COMMANDS[*]} " =~ " ${cmd} " ]]; then
        if [[ -z $cmd ]]; then
            _forbut_error "forgit: missing command\n\n"
        else
            _forbut_error "forgit: '%s' is not a valid forgit command.\n\n" "$cmd"
        fi
        _forbut_usage >&2
        return 1
    fi

    # Run prerequisites once per invocation
    _forbut_check_prerequisites || return 1
    _forbut_require_repo || return 1

    # Dispatch to the command function
    shift
    _forbut_"${cmd}" "$@"
}

# Check if the script is being sourced. This is necessary for unit tests where
# we do not want to execute the main function.
if [[ ${BASH_SOURCE[0]} != "$0" ]]; then
    return 0
fi

main "${@}"
